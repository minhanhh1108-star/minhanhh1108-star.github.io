{
  "api_version": "v21.0",
  "currency": "VND",
  "accounts": "auto",
  "kpi": {
    "primary_action": "lead",
    "fallback_actions": ["onsite_conversion.lead_grouped", "offsite_complete_registration_add_meta_leads", "onsite_conversion.messaging_conversation_started_7d"],
    "target_cpa": 150000,
    "max_frequency_7d": 3.0,
    "min_ctr_pct": 0.8
  },
  "guardrails": {
    "new_objects_status": "PAUSED",
    "max_new_daily_budget": 500000,
    "max_budget_change_pct": 30,
    "max_total_daily_budget_per_account": 5000000,
    "require_confirm_for": ["activate", "budget_change", "delete"]
  },
  "rules": {
    "kill_if_spend_x_target_no_result": 2.0,
    "kill_if_cpa_over_target_x": 1.5,
    "kill_min_spend_x_target": 2.0,
    "scale_if_cpa_under_target_x": 0.8,
    "scale_min_results": 10,
    "scale_step_pct": 20
  }
}
